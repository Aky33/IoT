{
  "name": "@iot/backend",
  "version": "0.1.0",
  "description": "Backend API for IoT care assistance button.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:watch": "vitest",
    "seed:admin": "node scripts/seed-admin.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^4.1.4"
  }
}
